# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
ENV/
env/

# AI assistant directories
.agent/
.claude/*
!.claude/skills/
.codex/
.gemini/
.opencode/
.windsurf/
.cursor/

# Database files (Turso/SQLite local replicas)
*.db
*.db-shm
*.db-wal
*.db-journal
*.db-info

# Extractor temporary files
extractor/tmp_extract/
.env*.local
